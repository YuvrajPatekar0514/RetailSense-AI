# RetailSense AI — Environment Configuration Example

# Application & Auth Settings
APP_NAME="RetailSense AI"
APP_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Default SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./retailsense.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retailsense_db

# LLM & OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Vector Database (ChromaDB / RAG)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
VECTORSTORE_DIR=./rag/vectorstore/storage

# Trained ML Model Paths
DEMAND_MODEL_PATH=./models/demand_model/best_model.pkl
SEGMENTATION_MODEL_PATH=./models/rfm_kmeans_model.pkl

# CORS Origins (Comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
